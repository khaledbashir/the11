### 3. Handler Implementation (`handler.js`)
```javascript
module.exports.runtime = {
  handler: async function ({ latitude, longitude }) {
    const callerId = `${this.config.name}-v${this.config.version}`;
    
    try {
      this.introspect(`${callerId} called with lat:${latitude} long:${longitude}...`);
      
      // Your custom logic here
      const result = await this._performCustomAction(latitude, longitude);
      
      return JSON.stringify(result);
    } catch (e) {
      this.introspect(`${callerId} failed: ${e.message}`);
      this.logger(`${callerId} error:`, e.message);
      return `Error: ${e.message}`;
    }
  },
  
  _performCustomAction: function(lat, lon) {
    // Implement your custom functionality
    return {
      location: { lat, lon },
      timestamp: new Date().toISOString(),
      status: "completed"
    };
  }
};
```

