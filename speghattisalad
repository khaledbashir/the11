## 🚀 Advanced Examples

### Multi-Step Workflow Skill
```javascript
// plugin.json
{
  "name": "Research Assistant",
  "hubId": "research-assistant", 
  "entrypoint": {
    "topic": { "type": "string", "required": true },
    "sources": { "type": "array", "required": false }
  }
}
```

```javascript
// handler.js
module.exports.runtime = {
  handler: async function ({ topic, sources = ['web', 'news'] }) {
    let researchData = {};
    
    for (const source of sources) {
      this.introspect(`Researching ${topic} from ${source}...`);
      
      if (source === 'web') {
        researchData.web = await this._searchWeb(topic);
      } else if (source === 'news') {
        researchData.news = await this._searchNews(topic);
      }
    }
    
    return JSON.stringify({
      topic,
      sources,
      data: researchData,
      summary: this._generateSummary(researchData)
    });
  }
};
```

### Database Integration Skill
```javascript
// handler.js
const sqlite3 = require('sqlite3').verbose();

module.exports.runtime = {
  handler: async function ({ query, databasePath }) {
    const db = new sqlite3.Database(databasePath || '/data/mydb.sqlite');
    
    return new Promise((resolve, reject) => {
      db.all(query, (err, rows) => {
        if (err) {
          this.introspect(`Database error: ${err.message}`);
          resolve(`Error executing query: ${err.message}`);
        } else {
          this.introspect(`Query returned ${rows.length} rows`);
          resolve(JSON.stringify(rows, null, 2));
        }
      });
    });
  }
};
```

